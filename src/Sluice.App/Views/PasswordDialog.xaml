<Window x:Class="Sluice.App.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Master password" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" Style="{StaticResource PageTitle}" FontSize="20"/>
        <TextBlock x:Name="Info" Style="{StaticResource PageSubtitle}"/>

        <TextBlock Text="Master password" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="Pass1"/>
        <StackPanel x:Name="ConfirmPanel">
            <TextBlock Text="Confirm" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="Pass2"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" MinWidth="90"/>
            <Button Content="OK" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" MinWidth="90" Margin="10,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
