<UserControl x:Class="Sluice.App.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Reset statistics" Command="{Binding ResetCommand}"/>
            <Border HorizontalAlignment="Left" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" Content="By application" IsChecked="{Binding ByApplication}" GroupName="stat"/>
                    <RadioButton Style="{StaticResource Segment}" Content="By target" IsChecked="{Binding ByTarget}" GroupName="stat"/>
                    <RadioButton Style="{StaticResource Segment}" Content="By rule" IsChecked="{Binding ByRule}" GroupName="stat"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBox}" Padding="8,12,8,8">
            <Grid>
                <DataGrid Style="{StaticResource Grid}" ItemsSource="{Binding Rows}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="2*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{Binding DataContext.KeyHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Key}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Share of traffic" Width="1.4*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Height="6" Margin="0,0,12,0">
                                        <Border Background="{DynamicResource Divider}" CornerRadius="3"/>
                                        <ProgressBar Value="{Binding Share, Mode=OneWay}" Maximum="1" Height="6" BorderThickness="0"
                                                     Background="Transparent" Foreground="{DynamicResource Accent}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="90"/>
                        <DataGridTextColumn Header="Sent" Binding="{Binding Sent}" Width="85"/>
                        <DataGridTextColumn Header="Received" Binding="{Binding Received}" Width="90"/>
                        <DataGridTextColumn Header="Conns" Binding="{Binding Connections}" Width="65"/>
                        <DataGridTextColumn Header="Open" Binding="{Binding Active}" Width="60"/>
                        <DataGridTextColumn Header="Failed" Binding="{Binding Failed}" Width="65"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No traffic yet" Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}" IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
