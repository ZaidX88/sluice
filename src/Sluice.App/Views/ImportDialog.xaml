<Window x:Class="Sluice.App.Views.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import tunnels" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource UiFont}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" MinWidth="90"/>
                    <Button x:Name="ImportButton" Content="Import" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnImport" MinWidth="90" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/>
            </DockPanel>
        </Border>

        <StackPanel Margin="24,20,24,20">
            <TextBlock Text="Import tunnels" Style="{StaticResource PageTitle}" FontSize="20"/>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="From share links (v2rayN, NekoRay, Shadowrocket, HTTP Injector…) or a subscription your provider gave you."/>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                <RadioButton x:Name="LinksMode" Style="{StaticResource Segment}" Content="Share links" GroupName="mode" IsChecked="True" Checked="OnModeChanged"/>
                <RadioButton x:Name="SubMode" Style="{StaticResource Segment}" Content="Subscription URL" GroupName="mode" Checked="OnModeChanged"/>
            </StackPanel>

            <StackPanel x:Name="LinksPanel">
                <TextBlock Text="Links — one per line" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="LinksBox" AcceptsReturn="True" TextWrapping="NoWrap" Height="170" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="vless://  vmess://  trojan://  ss://  hysteria2://  hy2://  tuic://  ssh://  socks5://  http(s)://  — or a base64 block of them."/>
            </StackPanel>

            <StackPanel x:Name="SubPanel" Visibility="Collapsed">
                <TextBlock Text="Subscription URL" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UrlBox" FontFamily="{StaticResource MonoFont}"/>
                <TextBlock Text="Name (optional)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameBox"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Sluice downloads the list now and again whenever you press Update. Tunnels keep their identity across updates, so rules that use them keep working; tunnels the provider drops are removed and their rules go Direct."/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
