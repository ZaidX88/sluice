<Window x:Class="Sluice.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Sluice.App.ViewModels"
        xmlns:v="clr-namespace:Sluice.App.Views"
        Title="Sluice" Width="1280" Height="800" MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <DataTemplate DataType="{x:Type vm:ConnectionsViewModel}"><v:ConnectionsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}"><v:StatisticsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogViewModel}"><v:LogView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TunnelsViewModel}"><v:TunnelsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RulesViewModel}"><v:RulesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" Background="{DynamicResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- ================= Brand (top-left) ================= -->
        <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                <Image x:Name="Logo" Width="26" Height="26"/>
                <TextBlock Text="sluice" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,1"/>
            </StackPanel>
        </Border>

        <!-- ================= Top bar ================= -->
        <Border Grid.Column="1" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Profile chip (like the user avatar in the reference) -->
                <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource Divider}" BorderThickness="1,0,0,0" Padding="22,0,24,0">
                    <Button x:Name="ProfileButton" Click="OnProfileMenu" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            ToolTip="{Binding ProfileHint}" Padding="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="34" Height="34">
                                <Ellipse Fill="{DynamicResource Accent}"/>
                                <TextBlock Text="{Binding ProfileInitial}" Foreground="{DynamicResource OnAccent}" FontWeight="Bold" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Margin="12,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProfileName}" FontWeight="Bold" FontSize="12" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Profile" Style="{StaticResource Muted}" FontSize="10.5"/>
                            </StackPanel>
                            <Border Width="22" Height="22" CornerRadius="11" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                            </Border>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open profile…" Command="{Binding OpenCommand}"/>
                                <MenuItem Header="Save" Command="{Binding SaveCommand}"/>
                                <MenuItem Header="Save as…" Command="{Binding SaveAsCommand}"/>
                                <MenuItem Header="Export for Proxifier (.ppx)…" Command="{Binding ExportProxifierCommand}"/>
                                <Separator/>
                                <MenuItem Header="New profile" Command="{Binding NewCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Border>

                <!-- Capture state (like the notification bell) -->
                <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource Divider}" BorderThickness="1,0,0,0" Padding="22,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Status}">
                        <Grid Width="10" Height="10" Margin="0,0,10,0">
                            <Ellipse Stroke="{DynamicResource Text}" StrokeThickness="1.5"/>
                            <Ellipse Fill="{DynamicResource Text}" Margin="2.5"
                                     Visibility="{Binding Intercepting, Converter={StaticResource Vis}}"/>
                        </Grid>
                        <TextBlock Text="{Binding CaptureTitle}" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Search -->
                <Grid Margin="32,0,24,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="{DynamicResource TextFaint}"/>
                    <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="24,0,0,0"
                             BorderThickness="0" Background="Transparent" Padding="0" FontSize="12" VerticalContentAlignment="Center">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                    <TextBlock Text="Search connections by app, host or rule" Margin="24,0,0,0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFaint}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ================= Sidebar ================= -->
        <Border Grid.Row="1" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
            <ItemsControl ItemsSource="{Binding NavGroups}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Header}" Style="{StaticResource GroupHeader}"/>
                            <ItemsControl ItemsSource="{Binding Pages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="{Binding Title}"
                                                     IsChecked="{Binding IsCurrent, Mode=OneWay}"
                                                     Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ================= Content ================= -->
        <DockPanel Grid.Row="1" Grid.Column="1" Margin="40,30,40,24">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding CurrentPage.Subtitle}" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <!-- Banner -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,16" Padding="14,10" CornerRadius="8"
                    Visibility="{Binding HasBanner, Converter={StaticResource Vis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BannerIsError}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource DangerSoft}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding DismissBannerCommand}" Height="28">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Restart as administrator" Margin="12,0,6,0"
                            Command="{Binding RestartElevatedCommand}" Visibility="{Binding BannerOffersElevation, Converter={StaticResource Vis}}"/>
                    <TextBlock Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                <Setter Property="Text" Value="&#xE946;"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BannerIsError}" Value="True">
                                        <Setter Property="Text" Value="&#xE7BA;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Banner}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <ContentControl Content="{Binding CurrentPage}" Focusable="False"/>
        </DockPanel>

        <!-- ================= Capture bar (like the music player bar) ================= -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
            <Grid Margin="28,0,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Now playing: what Sluice is doing -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentSoft}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="17" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Width="170">
                        <TextBlock Text="{Binding CaptureTitle}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="10.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <!-- Transport controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,28,0">
                    <Button Style="{StaticResource IconButton}" Command="{Binding DisconnectAllCommand}" ToolTip="Disconnect all connections">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="12" Foreground="{DynamicResource Text}"/>
                    </Button>
                    <Button Style="{StaticResource RoundButton}" Command="{Binding ToggleCaptureCommand}" Margin="14,0"
                            ToolTip="Start or stop capturing every application's traffic">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding CaptureGlyph}" FontSize="14" Foreground="{DynamicResource OnAccent}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding ShowLogCommand}" ToolTip="Open the log">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="13" Foreground="{DynamicResource Text}"/>
                    </Button>
                </StackPanel>

                <!-- Traffic line (like the progress bar) -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Width="92">
                        <TextBlock Text="UP" FontSize="9.5" Foreground="{DynamicResource TextFaint}"/>
                        <TextBlock Text="{Binding UpRate}" FontSize="11.5"/>
                    </StackPanel>
                    <Viewbox Grid.Column="1" Stretch="Fill" Height="28" Margin="8,0" ToolTip="{Binding Peak}">
                        <Canvas Width="360" Height="28">
                            <Line X1="0" X2="360" Y1="27" Y2="27" Stroke="{DynamicResource Divider}" StrokeThickness="1"/>
                            <Polygon Points="{Binding SparkArea}" Fill="{DynamicResource SparkFill}"/>
                            <Polyline Points="{Binding SparkLine}" Stroke="{DynamicResource Spark}" StrokeThickness="1.4"
                                      StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="92" Margin="8,0,0,0">
                        <TextBlock Text="DOWN" FontSize="9.5" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding DownRate}" FontSize="11.5" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <!-- Right: listener + totals -->
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="28,0,0,0">
                    <TextBlock Text="{Binding SocksText}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding Totals}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
