<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sluice.Desktop.Views.RuleDialog"
        Title="Rule" Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" Text="Add rule" Classes="PageTitle" FontSize="20"/>
        <TextBlock x:Name="DefaultNote" Classes="PageSubtitle" IsVisible="False"
                   Text="The Default rule applies to every connection no other rule matches. Only its action can change."/>

        <TextBlock Text="Name" Classes="FieldLabel"/>
        <TextBox x:Name="NameBox"/>

        <StackPanel x:Name="Conditions">
            <TextBlock Text="Applications" Classes="FieldLabel"/>
            <TextBox x:Name="AppsBox"/>
            <TextBlock Classes="Muted" Margin="0,4,0,0" Text="Empty = any app.   e.g.  chrome.exe; firefox; fire*; /usr/bin/curl"/>

            <TextBlock Text="Target hosts" Classes="FieldLabel"/>
            <TextBox x:Name="TargetsBox"/>
            <TextBlock Classes="Muted" Margin="0,4,0,0" Text="Empty = any host.   e.g.  *.example.com; 192.168.1.*; 10.0.0.0/8; 10.1.0.0-10.5.255.255"/>

            <TextBlock Text="Target ports" Classes="FieldLabel"/>
            <TextBox x:Name="PortsBox"/>
            <TextBlock Classes="Muted" Margin="0,4,0,0" Text="Empty = any port.   e.g.  80; 443; 8000-9000"/>
        </StackPanel>

        <TextBlock Text="Action" Classes="FieldLabel"/>
        <ComboBox x:Name="ActionBox" HorizontalAlignment="Stretch"/>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" Margin="0,12,0,0" TextWrapping="Wrap" IsVisible="False"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" Theme="{StaticResource SecondaryButton}" IsCancel="True" MinWidth="90" Click="OnCancel"/>
            <Button Content="Save" Theme="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSave" MinWidth="90" Margin="10,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
