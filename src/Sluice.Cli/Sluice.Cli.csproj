<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sluice.Core\Sluice.Core.csproj" />
    <!-- Linux capture; on Windows the CLI uses the WinDivert interceptor in Core. -->
    <ProjectReference Include="..\Sluice.Platform.Linux\Sluice.Platform.Linux.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Ignore DOTNET_STARTUP_HOOKS: the runtime must not load assemblies named by whoever starts Sluice. -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

</Project>
