<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sluice.Desktop.ViewModels"
             xmlns:c="using:Sluice.Desktop.Controls"
             x:Class="Sluice.Desktop.Views.ConnectionsView"
             x:DataType="vm:ConnectionsViewModel">
    <UserControl.Styles>
        <Style Selector="Ellipse.Dot"><Setter Property="Fill" Value="{DynamicResource Accent}"/></Style>
        <Style Selector="Ellipse.Dot.Direct"><Setter Property="Fill" Value="{DynamicResource TextFaint}"/></Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Why is nothing listed? -->
        <Border Grid.Row="1" Margin="0,0,0,14" Padding="14,10" CornerRadius="8" Background="{DynamicResource AccentSoft}"
                IsVisible="{Binding HasRoutingHint}">
            <DockPanel>
                <c:IconView Kind="info" Size="16" Foreground="{DynamicResource Accent}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                <TextBlock Text="{Binding RoutingHint}" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <DockPanel Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Theme="{StaticResource SecondaryButton}" Command="{Binding DisconnectCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <c:IconView Kind="close" Size="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Disconnect"/>
                    </StackPanel>
                </Button>
                <Button Theme="{StaticResource GhostButton}" Content="Disconnect all" Command="{Binding DisconnectAllCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Open now" Classes="SectionTitle" Margin="0"/>
                <Border Classes="Pill" Background="{DynamicResource AccentSoft}" Margin="10,0,0,0">
                    <TextBlock Text="{Binding Rows.Count}" FontSize="11" FontWeight="Bold"/>
                </Border>
                <TextBlock Text="{Binding Filter, StringFormat='matching “{0}”'}" Margin="12,0,0,0" VerticalAlignment="Center" Classes="Muted"
                           IsVisible="{Binding Filter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="2" Classes="CardBox" Padding="8,12,8,8">
            <Grid>
                <DataGrid Classes="Grid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Application" Width="1.3*" SortMemberPath="Application">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:ConnectionRow">
                                    <TextBlock Text="{Binding Application}" FontWeight="Bold" ToolTip.Tip="{Binding ProcessDetail}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Target" Binding="{ReflectionBinding Target}" Width="2*"/>
                        <DataGridTemplateColumn Header="Route" Width="1.6*" SortMemberPath="Via">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:ConnectionRow">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" Classes="Dot" Classes.Direct="{Binding IsDirect}"/>
                                        <TextBlock Text="{Binding Via}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Rule" Binding="{ReflectionBinding Rule}" Width="*"/>
                        <DataGridTextColumn Header="Sent" Binding="{ReflectionBinding Sent}" Width="80"/>
                        <DataGridTextColumn Header="Received" Binding="{ReflectionBinding Received}" Width="90"/>
                        <DataGridTextColumn Header="Time" Binding="{ReflectionBinding Duration}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEmpty}" IsHitTestVisible="False">
                    <c:IconView Kind="globe" Size="34" HorizontalAlignment="Center" Foreground="{DynamicResource TextFaint}"/>
                    <TextBlock Text="No open connections" HorizontalAlignment="Center" Margin="0,12,0,4" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Classes="Muted" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="360"
                               Text="Turn on interception to capture every app, or point an app at the local SOCKS5 server."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
