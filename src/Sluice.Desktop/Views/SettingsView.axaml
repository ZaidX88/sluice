<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sluice.Desktop.ViewModels"
             xmlns:c="using:Sluice.Desktop.Controls"
             x:Class="Sluice.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <!-- Three short sections with what most people change, then everything else under Advanced (#149, #147). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <!-- General -->
            <Border Classes="CardBox" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="General" Classes="SectionTitle"/>
                    <CheckBox Theme="{StaticResource Switch}" Margin="0,12,0,0" IsChecked="{Binding StartInterceptionOnLaunch}"
                              Content="Start capturing traffic when Sluice opens"/>
                    <CheckBox Theme="{StaticResource Switch}" Margin="0,14,0,0" IsChecked="{Binding StartAtLogin}"
                              IsVisible="{Binding AutostartSupported}" Content="Start Sluice when I log in"/>
                    <CheckBox Theme="{StaticResource Switch}" Margin="0,14,0,0" IsChecked="{Binding MinimizeToTray}"
                              Content="Keep running in the tray when the window is closed"/>
                    <CheckBox Theme="{StaticResource Switch}" Margin="0,14,0,0" IsChecked="{Binding TunnelNotifications}">
                        <StackPanel>
                            <TextBlock Text="Tunnel notifications"/>
                            <TextBlock Classes="Muted" Text="When a tunnel connects, disconnects or gives up."/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Privacy -->
            <Border Classes="CardBox" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Privacy" Classes="SectionTitle"/>
                    <TextBlock Text="Look up website names" Classes="FieldLabel" Margin="0,12,0,4"/>
                    <ComboBox ItemsSource="{Binding ResolveChoices}" SelectedIndex="{Binding ResolveIndex}"
                              HorizontalAlignment="Left" MinWidth="420"/>
                    <TextBlock Classes="Muted" Margin="0,6,0,0"
                               Text="Through the tunnel, names stay private and rules like *.example.com work."/>
                </StackPanel>
            </Border>

            <!-- Tunnels -->
            <Border Classes="CardBox" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Tunnels" Classes="SectionTitle"/>
                    <TextBlock Text="Stop a tunnel nothing uses" Classes="FieldLabel" Margin="0,12,0,4"/>
                    <ComboBox ItemsSource="{Binding IdleOptions}" SelectedIndex="{Binding IdleIndex}" HorizontalAlignment="Left" MinWidth="420"/>
                    <TextBlock Text="Games, calls and other non-web traffic of apps that use a tunnel" Classes="FieldLabel" Margin="0,16,0,4"/>
                    <ComboBox ItemsSource="{Binding UdpModes}" SelectedIndex="{Binding UdpIndex}" HorizontalAlignment="Left" MinWidth="420"/>
                </StackPanel>
            </Border>

            <!-- Advanced: closed by default; the state is remembered -->
            <Button Name="AdvancedToggle" Command="{Binding ToggleAdvancedCommand}" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" Padding="4,6" Margin="0,0,0,12" HorizontalAlignment="Left">
                <Button.Template>
                    <ControlTemplate><ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Background="Transparent"/></ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Advanced" Classes="SectionTitle" Margin="0" VerticalAlignment="Center"/>
                    <c:IconView Kind="chevron-down" Size="14" Margin="8,0,0,0" VerticalAlignment="Center"
                                Foreground="{DynamicResource Text}" IsVisible="{Binding !AdvancedOpen}"/>
                    <c:IconView Kind="chevron-up" Size="14" Margin="8,0,0,0" VerticalAlignment="Center"
                                Foreground="{DynamicResource Text}" IsVisible="{Binding AdvancedOpen}"/>
                </StackPanel>
            </Button>

            <Border Classes="CardBox" Margin="0,0,0,16" IsVisible="{Binding AdvancedOpen}">
                <StackPanel>
                    <!-- Name resolution -->
                    <TextBlock Text="Name resolution" Classes="SectionTitle"/>
                    <TextBlock Text="Look up these names on this PC" Classes="FieldLabel" Margin="0,12,0,4"/>
                    <TextBox Text="{Binding ExclusionList}"/>
                    <CheckBox Content="Invert: send only these names through the tunnel" IsChecked="{Binding OnlyListed}" Margin="0,8,0,0"/>
                    <CheckBox Theme="{StaticResource Switch}" Margin="0,14,0,0" IsChecked="{Binding LeakPrevention}">
                        <StackPanel>
                            <TextBlock Text="DNS and IP leak prevention"/>
                            <TextBlock Classes="Muted" Text="Never look up names on this PC, whatever the list above says."/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Theme="{StaticResource Switch}" Margin="0,14,0,0" IsChecked="{Binding BlockNonATypes}">
                        <StackPanel>
                            <TextBlock Text="Block other DNS query types"/>
                            <TextBlock Classes="Muted" Text="Answer TXT, MX, SRV… with no data for names sent through the tunnel."/>
                        </StackPanel>
                    </CheckBox>

                    <!-- Connections -->
                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,18"/>
                    <TextBlock Text="Connections" Classes="SectionTitle"/>
                    <CheckBox Theme="{StaticResource Switch}" Margin="0,12,0,0" IsChecked="{Binding LoopDetection}">
                        <StackPanel>
                            <TextBlock Text="Connection loop detection"/>
                            <TextBlock Classes="Muted" Text="A tunnel client on this PC (SSH, Xray…) always connects directly, never into itself."/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Theme="{StaticResource Switch}" Margin="0,14,0,0" IsChecked="{Binding HandleDirect}">
                        <StackPanel>
                            <TextBlock Text="Handle direct connections"/>
                            <TextBlock Classes="Muted" Text="Pass Direct connections through Sluice too, so they show in Connections and Statistics."/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Theme="{StaticResource Switch}" Margin="0,14,0,0" IsChecked="{Binding ProcessServices}">
                        <StackPanel>
                            <TextBlock Text="Include system services"/>
                            <TextBlock Classes="Muted" Text="Also apply rules to system processes whose owner can't be identified."/>
                        </StackPanel>
                    </CheckBox>

                    <!-- Log -->
                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,18"/>
                    <TextBlock Text="Log" Classes="SectionTitle"/>
                    <CheckBox Theme="{StaticResource Switch}" Margin="0,12,0,0" IsChecked="{Binding FileLog}">
                        <StackPanel>
                            <TextBlock Text="Write a log file"/>
                            <TextBlock Classes="Muted" TextWrapping="Wrap" Text="{Binding LogKeptText}"/>
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Text="Log detail" Classes="FieldLabel" Margin="0,12,0,4"/>
                    <ComboBox ItemsSource="{Binding LogLevels}" SelectedIndex="{Binding LogLevelIndex}" IsEnabled="{Binding FileLog}"
                              HorizontalAlignment="Left" MinWidth="420"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Classes="Muted" Text="{Binding LogDirectory}" VerticalAlignment="Center"/>
                        <Button Theme="{StaticResource GhostButton}" Content="Open folder" Command="{Binding OpenLogFolderCommand}"
                                Margin="4,0,0,0"/>
                    </StackPanel>

                    <!-- Local SOCKS5 server: applied when the field loses focus or on Enter -->
                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,18"/>
                    <TextBlock Text="Local SOCKS5 server" Classes="SectionTitle"/>
                    <TextBlock Text="Port" Classes="FieldLabel" Margin="0,12,0,4"/>
                    <TextBox Name="SocksPortBox" Text="{Binding SocksPortText}" Width="110" HorizontalAlignment="Left"
                             LostFocus="OnSocksPortCommit" KeyDown="OnSocksPortKey"/>
                    <TextBlock Classes="Muted" Margin="0,6,0,0" Foreground="{DynamicResource Danger}"
                               Text="Enter a port from 1 to 65535; the current one stays until then." IsVisible="{Binding SocksPortError}"/>
                    <TextBlock Classes="Muted" Margin="0,6,0,0" Text="Apps you point at 127.0.0.1 on this port use Sluice's rules even without capturing."/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
