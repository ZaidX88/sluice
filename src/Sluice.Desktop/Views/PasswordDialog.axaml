<c:SluiceWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Sluice.Desktop.Controls"
        x:Class="Sluice.Desktop.Views.PasswordDialog"
        Title="Master password" Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" Classes="PageTitle" FontSize="20"/>
        <TextBlock x:Name="Info" Classes="PageSubtitle"/>

        <TextBlock Text="Master password" Classes="FieldLabel"/>
        <TextBox x:Name="Pass1" PasswordChar="●"/>
        <StackPanel x:Name="ConfirmPanel">
            <TextBlock Text="Confirm" Classes="FieldLabel"/>
            <TextBox x:Name="Pass2" PasswordChar="●"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" Margin="0,12,0,0" TextWrapping="Wrap" IsVisible="False"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" Theme="{StaticResource SecondaryButton}" IsCancel="True" MinWidth="90" Click="OnCancel"/>
            <Button Content="OK" Theme="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" MinWidth="90" Margin="10,0,0,0"/>
        </StackPanel>
    </StackPanel>
</c:SluiceWindow>
