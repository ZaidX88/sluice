<UserControl x:Class="Sluice.App.Views.TunnelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Grid.ColumnSpan="2">
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock Text="Add tunnel"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding ImportCommand}" Margin="0,0,8,0" ToolTip="Paste share links (vless://, vmess://, ss://, trojan://, hy2://, tuic://…) or add a subscription">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock Text="Import"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SecondaryButton}" Content="Edit" Command="{Binding EditCommand}" Margin="0,0,8,0"/>
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding CheckCommand}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock Text="Check"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding CopyLinkCommand}" Margin="0,0,8,0" ToolTip="Copy a share link for the selected tunnel">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock Text="Copy link"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource DangerButton}" Content="Remove" Command="{Binding RemoveCommand}"/>
        </StackPanel>
        <Button Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource GhostButton}"
                Command="{Binding UpdateCommand}" Visibility="{Binding HasSubscriptions, Converter={StaticResource Vis}}"
                ToolTip="Download every subscription again">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding UpdateLabel}"/>
            </StackPanel>
        </Button>

        <Border Grid.Row="1" Style="{StaticResource CardBox}" Padding="8,12,8,8">
            <Grid>
                <DataGrid Style="{StaticResource Grid}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                          MouseDoubleClick="OnRowDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Tunnel" Width="1.3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Source, StringFormat=from {0}}" FontSize="11" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Source}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Type" Width="108">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pill}" Background="{DynamicResource AccentSoft}">
                                        <TextBlock Text="{Binding Type}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Address" Binding="{Binding Endpoint}" Width="1.7*"/>
                        <DataGridTextColumn Header="Login" Binding="{Binding Auth}" Width="0.8*"/>
                        <DataGridTemplateColumn Header="Status" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Ok}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Ok}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                    <TextBlock Text="No tunnels yet" HorizontalAlignment="Center" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0" Text="Add one or import share links, then point a rule at it."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Checker results -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBox}" Width="320" Margin="16,0,0,0"
                Visibility="{Binding HasCheck, Converter={StaticResource Vis}}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding CheckTitle}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding CheckSteps}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Mark}" VerticalAlignment="Top" Margin="0,2,0,0" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ok}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Ok}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
