<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared tests (owner): everything that doesn't depend on the OS. Runs on Windows and on Linux, as part of
       Sluice.Windows.slnf and Sluice.Linux.slnf. OS-specific tests go in Sluice.Tests.Windows / Sluice.Tests.Linux. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sluice.Core\Sluice.Core.csproj" />
    <ProjectReference Include="..\Sluice.Tests.Support\Sluice.Tests.Support.csproj" />
  </ItemGroup>

</Project>