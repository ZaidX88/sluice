<Window x:Class="Sluice.App.Views.TunnelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tunnel" Width="560" SizeToContent="Height" MaxHeight="860" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource UiFont}">
    <DockPanel>
        <!-- Buttons stay visible however long the form gets. -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" MinWidth="90"/>
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSave" MinWidth="90" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Margin="0,0,12,0" Visibility="Collapsed"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,20">
                <TextBlock x:Name="Heading" Text="Add tunnel" Style="{StaticResource PageTitle}" FontSize="20"/>

                <TextBlock Text="Protocol" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="TypeBox" SelectionChanged="OnTypeChanged">
                    <ComboBoxItem Content="SSH" Tag="Ssh"/>
                    <ComboBoxItem Content="SOCKS5" Tag="Socks5"/>
                    <ComboBoxItem Content="SOCKS4 / 4a" Tag="Socks4"/>
                    <ComboBoxItem Content="HTTPS (CONNECT)" Tag="Https"/>
                    <ComboBoxItem Content="HTTP" Tag="Http"/>
                </ComboBox>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Server" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="AddressBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PortBox"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="Socks4aBox" Content="Let the server resolve hostnames (SOCKS4a)" Margin="0,12,0,0" IsChecked="True"/>

                <TextBlock x:Name="AuthTitle" Text="Authentication (optional)" Style="{StaticResource FieldLabel}" Margin="0,18,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Username" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="UserBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Password" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="PassBox"/>
                    </StackPanel>
                </Grid>

                <!-- ============ SSH only ============ -->
                <StackPanel x:Name="SshPanel">
                    <DockPanel Margin="0,14,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Load key file…" Click="OnLoadKey" Height="26"/>
                        <TextBlock Text="Private key (instead of, or as well as, a password)" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox x:Name="KeyBox" AcceptsReturn="True" TextWrapping="NoWrap" Height="78" FontSize="10.5"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    <TextBlock Text="Key passphrase" Style="{StaticResource Muted}" Margin="0,8,0,4"/>
                    <PasswordBox x:Name="PassphraseBox"/>

                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,18,0,0"/>

                    <TextBlock Text="Connection mode" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="ModeBox" SelectionChanged="OnModeChanged">
                        <ComboBoxItem Content="Direct — plain SSH" Tag="direct"/>
                        <ComboBoxItem Content="Payload — send an HTTP request first" Tag="payload"/>
                        <ComboBoxItem Content="SSL/TLS — SSH inside TLS with a chosen SNI" Tag="tls"/>
                        <ComboBoxItem Content="SSL + payload — TLS, then the payload (e.g. WebSocket)" Tag="tls-payload"/>
                        <ComboBoxItem Content="Payload + SSL — payload (e.g. CONNECT), then TLS" Tag="payload-tls"/>
                    </ComboBox>

                    <StackPanel x:Name="PayloadPanel">
                        <TextBlock Text="Payload" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PayloadBox" AcceptsReturn="True" TextWrapping="Wrap" Height="72" FontSize="11.5"
                                 VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   Text="Placeholders: [host] [port] [host_port] [protocol] [ua] [raw] [crlf] [lf] [cr] [split]. Example: CONNECT [host_port] [protocol][crlf]Host: example.com[crlf][crlf]"/>
                        <CheckBox x:Name="SkipResponseBox" Content="Don't wait for a reply to the payload" Margin="0,10,0,0"/>
                        <StackPanel x:Name="RemoteProxyPanel">
                            <TextBlock Text="Remote HTTP proxy (optional, host:port)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="RemoteProxyBox"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="SniPanel">
                        <TextBlock Text="SNI (server name sent in TLS; empty = the server address)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SniBox"/>
                    </StackPanel>

                    <StackPanel x:Name="HostKeyPanel" Margin="0,16,0,0">
                        <TextBlock Text="Trusted host key" Style="{StaticResource Muted}"/>
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Forget" Click="OnForgetHostKey" Height="26"/>
                            <TextBlock x:Name="HostKeyText" FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Name (optional)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="LabelBox"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
