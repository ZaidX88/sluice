<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Monochrome: white surfaces, black as the only accent. -->
    <Color x:Key="AccentColor">#0A0A0A</Color>
    <Color x:Key="ShadowColor">#000000</Color>
    <SolidColorBrush x:Key="Bg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Sidebar" Color="#F7F7F8"/>
    <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#EDEDEF"/>
    <SolidColorBrush x:Key="Divider" Color="#EFEFF1"/>
    <SolidColorBrush x:Key="Text" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="TextMuted" Color="#7C7C83"/>
    <SolidColorBrush x:Key="TextFaint" Color="#B4B4BA"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#F1F1F2"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hover" Color="#EEEEF0"/>
    <SolidColorBrush x:Key="Selected" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="OnSelected" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RowHover" Color="#F7F7F8"/>
    <SolidColorBrush x:Key="RowSelected" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Success" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="SuccessSoft" Color="#F1F1F2"/>
    <SolidColorBrush x:Key="Warning" Color="#4A4A50"/>
    <SolidColorBrush x:Key="Danger" Color="#D33A3A"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#FBEDED"/>
    <SolidColorBrush x:Key="SwitchOff" Color="#D4D4D8"/>
    <SolidColorBrush x:Key="Spark" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="SparkFill" Color="#140A0A0A"/>
    <system:Double xmlns:system="clr-namespace:System;assembly=System.Runtime" x:Key="ShadowOpacity">0.07</system:Double>

    <!-- Make the Fluent controls monochrome too (focus underline, checkboxes, selected text …). -->
    <Color x:Key="SystemAccentColor">#0A0A0A</Color>
    <Color x:Key="SystemAccentColorLight1">#2A2A2E</Color>
    <Color x:Key="SystemAccentColorLight2">#4A4A50</Color>
    <Color x:Key="SystemAccentColorLight3">#6A6A70</Color>
    <Color x:Key="SystemAccentColorDark1">#0A0A0A</Color>
    <Color x:Key="SystemAccentColorDark2">#0A0A0A</Color>
    <Color x:Key="SystemAccentColorDark3">#0A0A0A</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#2A2A2E"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#4A4A50"/>
    <SolidColorBrush x:Key="AccentFillColorPrimaryBrush" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#2A2A2E"/>
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#4A4A50"/>
    <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#0A0A0A"/>
</ResourceDictionary>
