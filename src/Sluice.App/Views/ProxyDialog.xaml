<Window x:Class="Sluice.App.Views.ProxyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proxy server" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" Text="Add proxy server" Style="{StaticResource PageTitle}" FontSize="20"/>

        <TextBlock Text="Protocol" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="TypeBox" SelectionChanged="OnTypeChanged">
            <ComboBoxItem Content="SOCKS5" Tag="Socks5"/>
            <ComboBoxItem Content="SOCKS4 / 4a" Tag="Socks4"/>
            <ComboBoxItem Content="HTTPS (CONNECT)" Tag="Https"/>
            <ComboBoxItem Content="HTTP" Tag="Http"/>
        </ComboBox>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Address" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="AddressBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="PortBox"/>
            </StackPanel>
        </Grid>

        <CheckBox x:Name="Socks4aBox" Content="Let the proxy resolve hostnames (SOCKS4a)" Margin="0,12,0,0" IsChecked="True"/>

        <TextBlock Text="Authentication (optional)" Style="{StaticResource FieldLabel}" Margin="0,18,0,4"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Username" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                <TextBox x:Name="UserBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Password" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PassBox"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Label (optional)" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="LabelBox"/>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" MinWidth="90"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSave" MinWidth="90" Margin="10,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
