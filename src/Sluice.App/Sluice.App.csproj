<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sluice.Core\Sluice.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (System.Windows.Forms.NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Sluice</AssemblyName>
    <!-- Generated from the in-code mark by running Sluice.exe with the write-icon option (see App.xaml.cs). -->
    <ApplicationIcon>Sluice.ico</ApplicationIcon>
    <RootNamespace>Sluice.App</RootNamespace>
    <!-- WPF0001: Application.ThemeMode (Fluent theme) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- JetBrains Mono (SIL Open Font License, see Fonts/OFL.txt), embedded so the UI looks the same everywhere. -->
    <Resource Include="Fonts\*.ttf" />
    <None Include="Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep WinForms/GDI names out of the global namespace to avoid clashes with WPF types. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
